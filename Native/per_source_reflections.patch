diff --git a/resonance_audio/dsp/image_source_reflections.cc b/resonance_audio/dsp/image_source_reflections.cc
new file mode 100644
index 0000000..7fa5982
--- /dev/null
+++ b/resonance_audio/dsp/image_source_reflections.cc
@@ -0,0 +1,78 @@
+/*
+Copyright 2026. Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License. You may obtain
+a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+*/
+
+#include "dsp/image_source_reflections.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/logging.h"
+
+namespace vraudio {
+
+namespace {
+
+// Tiny inset so a clamped source sits just inside its wall rather than on it.
+const float kBoundaryInset = 1e-3f;
+
+// Sources closer than this count as this far away (see header).
+const float kReferenceDistance = 1.0f;
+
+}  // namespace
+
+void ComputeImageSourceReflections(
+    const WorldPosition& listener_position, const WorldPosition& source_position,
+    const WorldPosition& room_dimensions, const float* reflection_coefficients,
+    float min_path_difference, std::vector<DirectionalReflection>* reflections) {
+  DCHECK(reflection_coefficients);
+  DCHECK(reflections);
+  reflections->resize(kNumRoomSurfaces);
+  std::fill(reflections->begin(), reflections->end(), DirectionalReflection());
+
+  const WorldPosition kOrigin(0.0f, 0.0f, 0.0f);
+  if (!IsPositionInAabb(listener_position, kOrigin, room_dimensions)) {
+    return;  // Same rule as Resonance's own reflections.
+  }
+
+  const WorldPosition half = 0.5f * room_dimensions;
+  WorldPosition source = source_position;
+  for (int axis = 0; axis < 3; ++axis) {
+    const float limit = std::max(0.0f, half[axis] - kBoundaryInset);
+    source[axis] = std::min(std::max(source[axis], -limit), limit);
+  }
+
+  const float direct_distance = (source - listener_position).norm();
+  const float reference_distance = std::max(direct_distance, kReferenceDistance);
+
+  for (size_t wall = 0; wall < kNumRoomSurfaces; ++wall) {
+    const int axis = static_cast<int>(wall / 2);
+    const float wall_coordinate = (wall % 2 == 0) ? -half[axis] : half[axis];
+
+    WorldPosition image = source;
+    image[axis] = 2.0f * wall_coordinate - source[axis];
+
+    const WorldPosition to_image = image - listener_position;
+    const float image_distance = to_image.norm();
+    if (image_distance < 1e-6f) {
+      continue;  // Degenerate: listener and source both on this wall.
+    }
+
+    const float path_difference = std::max(0.0f, image_distance - direct_distance);
+    float fade = 1.0f;
+    if (min_path_difference > 0.0f) {
+      fade = std::min(1.0f, path_difference / min_path_difference);
+    }
+
+    DirectionalReflection& reflection = (*reflections)[wall];
+    reflection.delay_time_seconds = path_difference / kSpeedOfSound;
+    reflection.magnitude = fade * reflection_coefficients[wall] *
+                           reference_distance /
+                           std::max(image_distance, reference_distance);
+    reflection.direction = to_image / image_distance;
+  }
+}
+
+}  // namespace vraudio
diff --git a/resonance_audio/dsp/image_source_reflections.h b/resonance_audio/dsp/image_source_reflections.h
new file mode 100644
index 0000000..fe7cd84
--- /dev/null
+++ b/resonance_audio/dsp/image_source_reflections.h
@@ -0,0 +1,61 @@
+/*
+Copyright 2026. Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License. You may obtain
+a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+
+Per-source first-order image-source reflections for Resonance Audio's shoebox
+room model. Original Resonance computes ONE set of six reflections from the
+listener's position and applies it to every source ("all sources are attached
+to the listener"). This computes them per source: each wall's reflection comes
+from the source mirrored across that wall, so its delay, level and direction
+follow the actual source/wall/listener geometry.
+*/
+
+#ifndef RESONANCE_AUDIO_DSP_IMAGE_SOURCE_REFLECTIONS_H_
+#define RESONANCE_AUDIO_DSP_IMAGE_SOURCE_REFLECTIONS_H_
+
+#include <vector>
+
+#include "base/constants_and_types.h"
+#include "base/misc_math.h"
+
+namespace vraudio {
+
+// One first-order reflection of one source.
+struct DirectionalReflection {
+  // Arrival time AFTER the direct sound, in seconds. Resonance renders the
+  // direct path without propagation delay, so reflections are delayed by the
+  // extra path length only.
+  float delay_time_seconds = 0.0f;
+
+  // Level relative to the direct sound (the caller multiplies in the source's
+  // own reflections attenuation, which already contains its distance rolloff).
+  float magnitude = 0.0f;
+
+  // Unit direction from the listener towards the image source, in the room's
+  // local frame.
+  WorldPosition direction = WorldPosition(0.0f, 0.0f, 0.0f);
+};
+
+// Computes the six first-order reflections (walls in Resonance's order: -x
+// left, +x right, -y floor, +y ceiling, -z front, +z back) for a source and a
+// listener given in room-local coordinates (room centred on the origin).
+//
+// - No reflections if the listener is outside the room.
+// - A source outside the room is clamped onto its boundary.
+// - Level = coefficient * d_ref / d_image with d_ref = max(d_direct, 1 m): the
+//   inverse-distance law relative to the direct path, treating sources closer
+//   than 1 m as 1 m away (as Unity's default rolloff and Resonance's own
+//   "+1 m" padding do), so a source at the listener doesn't blow up.
+// - Reflections whose extra path is shorter than |min_path_difference| are
+//   faded out linearly: they arrive within a few milliseconds of the direct
+//   sound, where they only cause comb filtering (a footstep and its floor
+//   reflection are practically the same sound).
+void ComputeImageSourceReflections(
+    const WorldPosition& listener_position, const WorldPosition& source_position,
+    const WorldPosition& room_dimensions, const float* reflection_coefficients,
+    float min_path_difference, std::vector<DirectionalReflection>* reflections);
+
+}  // namespace vraudio
+
+#endif  // RESONANCE_AUDIO_DSP_IMAGE_SOURCE_REFLECTIONS_H_
diff --git a/resonance_audio/dsp/image_source_reflections_test.cc b/resonance_audio/dsp/image_source_reflections_test.cc
new file mode 100644
index 0000000..adb7560
--- /dev/null
+++ b/resonance_audio/dsp/image_source_reflections_test.cc
@@ -0,0 +1,114 @@
+/*
+Copyright 2026. Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License. You may obtain
+a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+*/
+
+#include "dsp/image_source_reflections.h"
+
+#include <vector>
+
+#include "third_party/googletest/googletest/include/gtest/gtest.h"
+
+namespace vraudio {
+
+namespace {
+
+const float kCoefficients[kNumRoomSurfaces] = {1.0f, 1.0f, 1.0f,
+                                               1.0f, 1.0f, 1.0f};
+const WorldPosition kCube10(10.0f, 10.0f, 10.0f);
+const float kTolerance = 1e-4f;
+
+std::vector<DirectionalReflection> Compute(const WorldPosition& listener,
+                                           const WorldPosition& source,
+                                           const WorldPosition& room,
+                                           float min_path_difference = 0.0f) {
+  std::vector<DirectionalReflection> reflections;
+  ComputeImageSourceReflections(listener, source, room, kCoefficients,
+                                min_path_difference, &reflections);
+  return reflections;
+}
+
+}  // namespace
+
+// Listener outside the room: no reflections at all (Resonance's own rule).
+TEST(ImageSourceReflectionsTest, ListenerOutsideRoomGivesNothing) {
+  const auto reflections = Compute(WorldPosition(20.0f, 0.0f, 0.0f),
+                                   WorldPosition(0.0f, 0.0f, 0.0f), kCube10);
+  ASSERT_EQ(reflections.size(), kNumRoomSurfaces);
+  for (const auto& r : reflections) {
+    EXPECT_EQ(r.magnitude, 0.0f);
+  }
+}
+
+// Source at the listener in the centre of a 10 m cube: every image is 10 m away,
+// so all six reflections are identical - this is the case where the original
+// listener-centric model and the image-source model coincide.
+TEST(ImageSourceReflectionsTest, SourceAtListenerIsSymmetric) {
+  const WorldPosition centre(0.0f, 0.0f, 0.0f);
+  const auto reflections = Compute(centre, centre, kCube10);
+  for (const auto& r : reflections) {
+    EXPECT_NEAR(r.delay_time_seconds, 10.0f / kSpeedOfSound, kTolerance);
+    EXPECT_NEAR(r.magnitude, 1.0f / 10.0f, kTolerance);  // d_ref 1 m / 10 m
+  }
+  // Wall order: -x, +x, -y, +y, -z, +z; directions point at each wall.
+  EXPECT_NEAR(reflections[0].direction[0], -1.0f, kTolerance);
+  EXPECT_NEAR(reflections[1].direction[0], 1.0f, kTolerance);
+  EXPECT_NEAR(reflections[2].direction[1], -1.0f, kTolerance);
+  EXPECT_NEAR(reflections[3].direction[1], 1.0f, kTolerance);
+  EXPECT_NEAR(reflections[4].direction[2], -1.0f, kTolerance);
+  EXPECT_NEAR(reflections[5].direction[2], 1.0f, kTolerance);
+}
+
+// Hand-computed case: listener at the centre, source 2 m to the right. The +x
+// wall (x = 5) mirrors the source to x = 8: path 8 m vs direct 2 m.
+TEST(ImageSourceReflectionsTest, DelayAndLevelFollowPathLengths) {
+  const auto reflections = Compute(WorldPosition(0.0f, 0.0f, 0.0f),
+                                   WorldPosition(2.0f, 0.0f, 0.0f), kCube10);
+  EXPECT_NEAR(reflections[1].delay_time_seconds, 6.0f / kSpeedOfSound, kTolerance);
+  EXPECT_NEAR(reflections[1].magnitude, 2.0f / 8.0f, kTolerance);
+  // The -x wall (x = -5) mirrors it to x = -12: path 12 m.
+  EXPECT_NEAR(reflections[0].delay_time_seconds, 10.0f / kSpeedOfSound, kTolerance);
+  EXPECT_NEAR(reflections[0].magnitude, 2.0f / 12.0f, kTolerance);
+  EXPECT_NEAR(reflections[0].direction[0], -1.0f, kTolerance);
+}
+
+// The point of the whole change: two sources at different positions get
+// different reflections for the same listener, unlike original Resonance.
+TEST(ImageSourceReflectionsTest, ReflectionsDependOnSourcePosition) {
+  const WorldPosition listener(0.0f, 0.0f, 0.0f);
+  const auto left = Compute(listener, WorldPosition(-4.0f, 0.0f, 0.0f), kCube10);
+  const auto right = Compute(listener, WorldPosition(4.0f, 0.0f, 0.0f), kCube10);
+  // A source near the left wall: its left-wall reflection arrives soon after
+  // the direct sound; for a source near the right wall that reflection is late.
+  EXPECT_LT(left[0].delay_time_seconds, right[0].delay_time_seconds);
+  EXPECT_GT(left[0].magnitude, right[0].magnitude);
+}
+
+// Extra paths shorter than min_path_difference fade out: a footstep right on
+// the floor and its floor image are practically the same sound.
+TEST(ImageSourceReflectionsTest, NearCoincidentReflectionsFade) {
+  // Room floor at y = -5. Listener 1.7 m above it, source 0.05 m above it.
+  const WorldPosition listener(0.0f, -3.3f, 0.0f);
+  const WorldPosition source(0.0f, -4.95f, 0.0f);
+  const auto faded = Compute(listener, source, kCube10, 1.0f);
+  const auto unfaded = Compute(listener, source, kCube10, 0.0f);
+  // Floor path difference is 2 * 0.05 = 0.1 m -> 10% of the unfaded level.
+  EXPECT_NEAR(faded[2].magnitude, 0.1f * unfaded[2].magnitude, kTolerance);
+  // Walls far from both are unaffected.
+  EXPECT_NEAR(faded[0].magnitude, unfaded[0].magnitude, kTolerance);
+}
+
+// A source outside the room is clamped onto the boundary, not mirrored wildly.
+TEST(ImageSourceReflectionsTest, SourceOutsideRoomIsClamped) {
+  const auto reflections = Compute(WorldPosition(0.0f, 0.0f, 0.0f),
+                                   WorldPosition(50.0f, 0.0f, 0.0f), kCube10);
+  // Clamped to x ~ 5: the +x image coincides with the source -> zero extra path.
+  EXPECT_NEAR(reflections[1].delay_time_seconds, 0.0f, 1e-3f);
+  for (const auto& r : reflections) {
+    EXPECT_GE(r.delay_time_seconds, 0.0f);
+    EXPECT_LT(r.delay_time_seconds, 1.0f);
+  }
+}
+
+}  // namespace vraudio
