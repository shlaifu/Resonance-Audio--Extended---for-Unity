+a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+*/
+
+#include "graph/per_source_reflections_node.h"
+
+#include <cmath>
+#include <vector>
+
+#include "third_party/googletest/googletest/include/gtest/gtest.h"
+
+namespace vraudio {
+
+namespace {
+
+const size_t kFramesPerBuffer = 256;
+const int kSampleRate = 48000;
+const SourceId kSourceA = 1;
+const SourceId kSourceB = 2;
+
+}  // namespace
+
+class PerSourceReflectionsNodeTest : public ::testing::Test {
+ protected:
+  PerSourceReflectionsNodeTest()
+      : system_settings_(kNumStereoChannels, kFramesPerBuffer, kSampleRate) {}
+
+  void SetUp() override {
+    // 10 m cube at the origin, fully reflective, listener at the centre.
+    ReflectionProperties properties;
+    for (int i = 0; i < 3; ++i) properties.room_dimensions[i] = 10.0f;
+    for (size_t i = 0; i < kNumRoomSurfaces; ++i) properties.coefficients[i] = 1.0f;
+    properties.cutoff_frequency = 0.5f * kSampleRate;  // effectively unfiltered
+    properties.gain = 1.0f;
+    system_settings_.SetReflectionProperties(properties);
+    system_settings_.SetHeadPosition(WorldPosition(0.0f, 0.0f, 0.0f));
+    system_settings_.SetHeadRotation(WorldRotation::Identity());
+    Register(kSourceA, WorldPosition(-4.0f, 0.0f, 0.0f));
+    Register(kSourceB, WorldPosition(4.0f, 0.0f, 0.0f));
+  }
+
+  void Register(SourceId id, const WorldPosition& position) {
+    system_settings_.GetSourceParametersManager()->Register(id);
+    SourceParameters* p =
+        system_settings_.GetSourceParametersManager()->GetMutableParameters(id);
+    p->object_transform.position = position;
+    p->attenuations[AttenuationType::kReflections] = 1.0f;
+  }
+
+  const AudioBuffer* Process(PerSourceReflectionsNode* node,
+                             const std::vector<const AudioBuffer*>& inputs) {
+    return node->AudioProcess(ProcessingNode::NodeInput(inputs));
+  }
+
+  // An impulse in the first buffer, silence after - like a footstep.
+  static AudioBuffer Impulse(SourceId id) {
+    AudioBuffer buffer(kNumMonoChannels, kFramesPerBuffer);
+    buffer.Clear();
+    buffer[0][0] = 1.0f;
+    buffer.set_source_id(id);
+    return buffer;
+  }
+
+  // Sum of W*Y over enough buffers to capture all reflections: positive when
+  // the reflected energy comes predominantly from the LEFT (+Y).
+  double LeftRightBalance(PerSourceReflectionsNode* node, SourceId id) {
+    AudioBuffer impulse = Impulse(id);
+    AudioBuffer silence(kNumMonoChannels, kFramesPerBuffer);
+    silence.Clear();
+    silence.set_source_id(id);
+    double balance = 0.0;
+    for (int b = 0; b < 40; ++b) {
+      const AudioBuffer* out = Process(node, {b == 0 ? &impulse : &silence});
+      if (out == nullptr) continue;
+      for (size_t f = 0; f < kFramesPerBuffer; ++f) {
+        balance += (*out)[0][f] * (*out)[1][f];
+      }
+    }
+    return balance;
+  }
+
+  SystemSettings system_settings_;
+};
+
+// A source near the LEFT wall must have its strongest, earliest reflection
+// from the left, and one near the right wall from the right. Original
+// Resonance rendered identical reflections for both (listener-centric).
+TEST_F(PerSourceReflectionsNodeTest, ReflectionDirectionFollowsSource) {
+  PerSourceReflectionsNode node_a(system_settings_);
+  PerSourceReflectionsNode node_b(system_settings_);
+  EXPECT_GT(LeftRightBalance(&node_a, kSourceA), 0.0);
+  EXPECT_LT(LeftRightBalance(&node_b, kSourceB), 0.0);
+}
+
+// Reflections keep ringing after the input stops, then the node goes quiet.
+TEST_F(PerSourceReflectionsNodeTest, TailRingsOutThenStops) {
+  PerSourceReflectionsNode node(system_settings_);
+  AudioBuffer impulse = Impulse(kSourceA);
+  const AudioBuffer* first = Process(&node, {&impulse});
+  ASSERT_NE(first, nullptr);
+
+  // No input at all from now on (the source stopped playing).
+  int buffers_with_output = 0;
+  bool went_quiet = false;
+  for (int b = 0; b < 200; ++b) {
+    const AudioBuffer* out = Process(&node, {});
+    if (out == nullptr) {
+      went_quiet = true;
+      break;
+    }
+    ++buffers_with_output;
+  }
+  EXPECT_GT(buffers_with_output, 0);  // the tail was rendered
+  EXPECT_TRUE(went_quiet);            // and then it stopped
+}
+
+// Muted (room effects disabled): inputs are ignored.
+TEST_F(PerSourceReflectionsNodeTest, MuteIgnoresInput) {
+  PerSourceReflectionsNode node(system_settings_);
+  node.SetMute(true);
+  AudioBuffer impulse = Impulse(kSourceA);
+  EXPECT_EQ(Process(&node, {&impulse}), nullptr);
+}
+
+// Output energy scales with the source's reflections attenuation.
+TEST_F(PerSourceReflectionsNodeTest, AttenuationScalesOutput) {
+  auto energy = [this](float attenuation) {
+    system_settings_.GetSourceParametersManager()
+        ->GetMutableParameters(kSourceA)
+        ->attenuations[AttenuationType::kReflections] = attenuation;
+    PerSourceReflectionsNode node(system_settings_);
+    AudioBuffer impulse = Impulse(kSourceA);
+    AudioBuffer silence(kNumMonoChannels, kFramesPerBuffer);
+    silence.Clear();
+    silence.set_source_id(kSourceA);
+    double e = 0.0;
+    for (int b = 0; b < 40; ++b) {
+      const AudioBuffer* out = Process(&node, {b == 0 ? &impulse : &silence});
+      if (out == nullptr) continue;
+      for (size_t f = 0; f < kFramesPerBuffer; ++f) e += (*out)[0][f] * (*out)[0][f];
+    }
+    return e;
+  };
+  const double full = energy(1.0f);
+  const double half = energy(0.5f);
+  EXPECT_GT(full, 0.0);
+  EXPECT_NEAR(half / full, 0.25, 0.05);  // amplitude 0.5 -> energy 0.25
+}
