+++ b/resonance_audio/graph/per_source_reflections_node.h
@@ -0,0 +1,119 @@
+/*
+Copyright 2026. Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License. You may obtain
+a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+
+Replacement for ReflectionsNode that renders early reflections PER SOURCE.
+
+Original Resonance mixes every source into one mono signal and runs a single
+set of six listener-centric reflections on the mix, so every source - a
+footstep at your feet, a gunshot 40 m away - gets identical reflections that
+depend only on where the LISTENER stands. This node takes each source's own
+buffer, computes its six image-source reflections from that source's position
+(dsp/image_source_reflections.h) and renders them through a small per-source
+delay line into one shared first-order Ambisonic output, which is then rotated
+into the listener's head frame exactly as before.
+
+Room geometry, wall coefficients and the reflection low-pass cutoff still come
+from the global ReflectionProperties (SetReflectionProperties /
+SetRoomProperties), so the C# side is unchanged.
+*/
+
+#ifndef RESONANCE_AUDIO_GRAPH_PER_SOURCE_REFLECTIONS_NODE_H_
+#define RESONANCE_AUDIO_GRAPH_PER_SOURCE_REFLECTIONS_NODE_H_
+
+#include <memory>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "ambisonics/foa_rotator.h"
+#include "base/audio_buffer.h"
+#include "base/constants_and_types.h"
+#include "base/misc_math.h"
+#include "dsp/delay_filter.h"
+#include "dsp/gain_processor.h"
+#include "dsp/image_source_reflections.h"
+#include "dsp/mono_pole_filter.h"
+#include "graph/system_settings.h"
+#include "node/processing_node.h"
+#include "utils/buffer_crossfader.h"
+
+namespace vraudio {
+
+class PerSourceReflectionsNode : public ProcessingNode {
+ public:
+  explicit PerSourceReflectionsNode(const SystemSettings& system_settings);
+  // Out of line: SourceState is only complete in the .cc file.
+  ~PerSourceReflectionsNode() override;
+
+  // Kept for call-site compatibility with ReflectionsNode::Update(). Targets
+  // are recomputed from the current settings on every buffer, so this is a
+  // no-op.
+  void Update() {}
+
+  // While muted (room effects disabled) inputs are ignored; reflection tails
+  // already in flight still ring out.
+  void SetMute(bool mute_enabled) { mute_enabled_ = mute_enabled; }
+
+  // Marks a source as listener-centric (soundfield/ambisonic beds have no
+  // meaningful position): it gets reflections computed as if it were at the
+  // listener, which is what original Resonance did for everything.
+  void SetListenerCentric(SourceId source_id);
+
+  // Never disconnect when all sources are gone (same as GainMixerNode).
+  bool CleanUp() final;
+
+ protected:
+  const AudioBuffer* AudioProcess(const NodeInput& input) override;
+
+ private:
+  friend class PerSourceReflectionsNodeTest;
+
+  struct SourceState;
+
+  SourceState* GetOrCreateState(SourceId source_id);
+
+  // Computes targets for |state| from the current settings and its position.
+  void UpdateTargets(const WorldPosition& listener_local,
+                     const WorldPosition& source_world, float attenuation,
+                     SourceState* state);
+
+  // Renders one buffer of |state| from |input| and adds it to |output_buffer_|.
+  void ProcessSource(const AudioBuffer::Channel& input, SourceState* state);
+
+  // Renders the six taps with the given delays/directions into |output|.
+  void ApplyTaps(const std::vector<size_t>& delays,
+                 const std::vector<WorldPosition>& directions,
+                 SourceState* state, AudioBuffer* output);
+
+  const SystemSettings& system_settings_;
+  const int sample_rate_;
+  const size_t frames_per_buffer_;
+  const size_t max_delay_samples_;
+
+  bool mute_enabled_;
+
+  std::unordered_map<SourceId, std::unique_ptr<SourceState>> states_;
+  std::unordered_set<SourceId> listener_centric_sources_;
+
+  FoaRotator foa_rotator_;
+  BufferCrossfader crossfader_;
+
+  AudioBuffer output_buffer_;
+  AudioBuffer silence_mono_buffer_;
+  AudioBuffer current_taps_buffer_;
+  AudioBuffer target_taps_buffer_;
+  AudioBuffer crossfade_buffer_;
+
+  // Cached global reflection state for this buffer.
+  WorldPosition room_position_;
+  WorldRotation room_rotation_;
+  WorldPosition room_dimensions_;
+  float coefficients_[kNumRoomSurfaces];
+  float cutoff_frequency_;
+};
+
+}  // namespace vraudio
+
+#endif  // RESONANCE_AUDIO_GRAPH_PER_SOURCE_REFLECTIONS_NODE_H_
