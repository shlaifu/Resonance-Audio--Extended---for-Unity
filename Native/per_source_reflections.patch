+void EXPORT_API SetListenerTransformFromScript(const float* listener_to_world) {
+  if (listener_to_world == nullptr) {
+    // Hand the pose back to the renderer callback.
+    listener_from_script.store(false);
+    return;
+  }
+  // |listener_to_world| is a Unity Matrix4x4 (column-major, left-handed) - the
+  // same convention as the inverted |unity_listener_transform| above.
+  Eigen::Matrix4f listener_transform(listener_to_world);
+  FlipZAxis(&listener_transform);
+  const Eigen::Vector3f position = GetPosition(listener_transform);
+  const Eigen::Quaternionf rotation = GetQuaternion(listener_transform);
+  if (!position.allFinite() || !rotation.coeffs().allFinite()) {
+    return;
+  }
+  // Thread-safe: the API queues these and applies them on the audio thread.
+  SetListenerTransform(position.x(), position.y(), position.z(), rotation.x(),
+                       rotation.y(), rotation.z(), rotation.w());
+  listener_from_script.store(true);
+}
