+++ b/resonance_audio/graph/per_source_reflections_node.cc
@@ -0,0 +1,313 @@
+/*
+Copyright 2026. Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License. You may obtain
+a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+*/
+
+#include "graph/per_source_reflections_node.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/logging.h"
+#include "base/simd_utils.h"
+#include "dsp/filter_coefficient_generators.h"
+#include "dsp/gain.h"
+
+namespace vraudio {
+
+namespace {
+
+// Longest reflection delay rendered. Delays are path DIFFERENCES (image path
+// minus direct path), which in a room of up to ~50 m per side stay well below
+// this; anything longer is clamped.
+const float kMaxDelayTimeSeconds = 0.5f;
+
+// Reflections whose extra path is shorter than this fade out (see
+// ComputeImageSourceReflections): they only comb-filter the direct sound.
+const float kMinPathDifference = 1.0f;
+
+// Re-crossfade only when a tap moved by at least this much.
+const float kDirectionEpsilon = 1e-3f;
+
+// Ambisonic first-order encoding of a world-space (Resonance audio-space:
+// x right, y up, -z forward) direction in ACN order W, Y, Z, X with SN3D-style
+// unit weights - identical to what ReflectionsProcessor hard-codes for its six
+// axis-aligned walls (left wall -> Y += 1, floor -> Z -= 1, front -> X += 1).
+inline void EncodeDirection(const WorldPosition& d, float* y, float* z,
+                            float* x) {
+  *y = -d[0];
+  *z = d[1];
+  *x = -d[2];
+}
+
+}  // namespace
+
+struct PerSourceReflectionsNode::SourceState {
+  SourceState(size_t max_delay_samples, size_t frames_per_buffer)
+      : low_pass_filter(0.0f),
+        filtered_input(kNumMonoChannels, frames_per_buffer),
+        delay_filter(max_delay_samples, frames_per_buffer),
+        tap_buffer(kNumRoomSurfaces, frames_per_buffer),
+        delays(kNumRoomSurfaces, 0),
+        target_delays(kNumRoomSurfaces, 0),
+        directions(kNumRoomSurfaces, WorldPosition(0.0f, 0.0f, 0.0f)),
+        target_directions(kNumRoomSurfaces, WorldPosition(0.0f, 0.0f, 0.0f)),
+        target_gains(kNumRoomSurfaces, 0.0f),
+        gain_processors(kNumRoomSurfaces),
+        reflections(kNumRoomSurfaces) {}
+
+  MonoPoleFilter low_pass_filter;
+  float cutoff_frequency = -1.0f;
+  AudioBuffer filtered_input;
+  DelayFilter delay_filter;
+  AudioBuffer tap_buffer;
+
+  std::vector<size_t> delays;
+  std::vector<size_t> target_delays;
+  std::vector<WorldPosition> directions;
+  std::vector<WorldPosition> target_directions;
+  std::vector<float> target_gains;
+  std::vector<GainProcessor> gain_processors;
+  std::vector<DirectionalReflection> reflections;
+
+  // Last known values, used for the tail after the source stops or is gone.
+  float attenuation = 0.0f;
+  WorldPosition position = WorldPosition(0.0f, 0.0f, 0.0f);
+
+  bool initialized = false;
+  bool seen_this_buffer = false;
+  size_t frames_since_input = 0;
+  size_t tail_frames = 0;
+};
+
+PerSourceReflectionsNode::PerSourceReflectionsNode(
+    const SystemSettings& system_settings)
+    : system_settings_(system_settings),
+      sample_rate_(system_settings.GetSampleRateHz()),
+      frames_per_buffer_(system_settings.GetFramesPerBuffer()),
+      max_delay_samples_(static_cast<size_t>(
+          kMaxDelayTimeSeconds * static_cast<float>(sample_rate_))),
+      mute_enabled_(false),
+      crossfader_(frames_per_buffer_),
+      output_buffer_(kNumFirstOrderAmbisonicChannels, frames_per_buffer_),
+      silence_mono_buffer_(kNumMonoChannels, frames_per_buffer_),
+      current_taps_buffer_(kNumFirstOrderAmbisonicChannels, frames_per_buffer_),
+      target_taps_buffer_(kNumFirstOrderAmbisonicChannels, frames_per_buffer_),
+      crossfade_buffer_(kNumFirstOrderAmbisonicChannels, frames_per_buffer_),
+      room_position_(0.0f, 0.0f, 0.0f),
+      room_rotation_(WorldRotation::Identity()),
+      room_dimensions_(0.0f, 0.0f, 0.0f),
+      cutoff_frequency_(0.0f) {
+  silence_mono_buffer_.Clear();
+  std::fill(std::begin(coefficients_), std::end(coefficients_), 0.0f);
+  // Keep running without input so tails ring out.
+  EnableProcessOnEmptyInput(true);
+}
+
+PerSourceReflectionsNode::~PerSourceReflectionsNode() = default;
+
+void PerSourceReflectionsNode::SetListenerCentric(SourceId source_id) {
+  listener_centric_sources_.insert(source_id);
+}
+
+bool PerSourceReflectionsNode::CleanUp() {
+  CallCleanUpOnInputNodes();
+  return false;
+}
+
+PerSourceReflectionsNode::SourceState* PerSourceReflectionsNode::GetOrCreateState(
+    SourceId source_id) {
+  auto it = states_.find(source_id);
+  if (it != states_.end()) {
+    return it->second.get();
+  }
+  std::unique_ptr<SourceState> state(
+      new SourceState(max_delay_samples_, frames_per_buffer_));
+  SourceState* raw = state.get();
+  states_[source_id] = std::move(state);
+  return raw;
+}
+
+void PerSourceReflectionsNode::UpdateTargets(const WorldPosition& listener_local,
+                                             const WorldPosition& source_world,
+                                             float attenuation,
+                                             SourceState* state) {
+  // Same room-local convention as ReflectionsProcessor::Update.
+  WorldPosition source_local;
+  GetRelativeDirection(room_position_, room_rotation_.conjugate(), source_world,
+                       &source_local);
+
+  ComputeImageSourceReflections(listener_local, source_local, room_dimensions_,
+                                coefficients_, kMinPathDifference,
+                                &state->reflections);
+
+  // Back from room-local to world directions (inverse of the transform above).
+  const WorldRotation local_to_world = room_rotation_.conjugate();
+  float max_delay_seconds = 0.0f;
+  for (size_t i = 0; i < kNumRoomSurfaces; ++i) {
+    const DirectionalReflection& r = state->reflections[i];
+    state->target_delays[i] = std::min(
+        max_delay_samples_ - 1,
+        static_cast<size_t>(r.delay_time_seconds * static_cast<float>(sample_rate_)));
+    state->target_gains[i] = r.magnitude * attenuation;
+    state->target_directions[i] = local_to_world * r.direction;
+    max_delay_seconds = std::max(max_delay_seconds, r.delay_time_seconds);
+  }
+  state->tail_frames =
+      frames_per_buffer_ +
+      std::min(max_delay_samples_,
+               static_cast<size_t>(max_delay_seconds * static_cast<float>(sample_rate_)));
+
+  if (state->cutoff_frequency != cutoff_frequency_) {
+    state->cutoff_frequency = cutoff_frequency_;
+    state->low_pass_filter.SetCoefficient(
+        ComputeLowPassMonoPoleCoefficient(cutoff_frequency_, sample_rate_));
+  }
+}
+
+void PerSourceReflectionsNode::ApplyTaps(
+    const std::vector<size_t>& delays,
+    const std::vector<WorldPosition>& directions, SourceState* state,
+    AudioBuffer* output) {
+  output->Clear();
+  for (size_t i = 0; i < kNumRoomSurfaces; ++i) {
+    AudioBuffer::Channel* tap = &state->tap_buffer[i];
+    state->delay_filter.GetDelayedData(delays[i], tap);
+
+    GainProcessor& gain = state->gain_processors[i];
+    if (IsGainNearZero(state->target_gains[i]) && IsGainNearZero(gain.GetGain())) {
+      gain.Reset(0.0f);
+      continue;
+    }
+    gain.ApplyGain(state->target_gains[i], *tap, tap, false /* accumulate */);
+
+    float y, z, x;
+    EncodeDirection(directions[i], &y, &z, &x);
+    (*output)[0] += *tap;
+    ScalarMultiplyAndAccumulate(frames_per_buffer_, y, tap->begin(), (*output)[1].begin());
+    ScalarMultiplyAndAccumulate(frames_per_buffer_, z, tap->begin(), (*output)[2].begin());
+    ScalarMultiplyAndAccumulate(frames_per_buffer_, x, tap->begin(), (*output)[3].begin());
+  }
+}
+
+void PerSourceReflectionsNode::ProcessSource(const AudioBuffer::Channel& input,
+                                             SourceState* state) {
+  // Reflections are low-passed like the original (wall absorption is
+  // frequency dependent); one filter per source since inputs aren't mixed.
+  AudioBuffer::Channel* filtered = &state->filtered_input[0];
+  const bool filtered_ok = state->low_pass_filter.Filter(input, filtered);
+  state->delay_filter.InsertData(filtered_ok ? *filtered : input);
+
+  bool changed = !state->initialized;
+  for (size_t i = 0; i < kNumRoomSurfaces && !changed; ++i) {
+    changed = state->target_delays[i] != state->delays[i] ||
+              (state->target_directions[i] - state->directions[i]).norm() >
+                  kDirectionEpsilon;
+  }
+
+  if (!state->initialized) {
+    // First buffer: start directly on the targets, nothing to crossfade from.
+    state->delays = state->target_delays;
+    state->directions = state->target_directions;
+    state->initialized = true;
+    changed = false;
+  }
+
+  if (changed) {
+    // Same scheme as ReflectionsProcessor: render old and new taps and
+    // crossfade linearly over the buffer, so moving delays don't click.
+    ApplyTaps(state->delays, state->directions, state, &current_taps_buffer_);
+    state->delays = state->target_delays;
+    state->directions = state->target_directions;
+    ApplyTaps(state->delays, state->directions, state, &target_taps_buffer_);
+    crossfader_.ApplyLinearCrossfade(target_taps_buffer_, current_taps_buffer_,
+                                     &crossfade_buffer_);
+  } else {
+    ApplyTaps(state->delays, state->directions, state, &crossfade_buffer_);
+  }
+
+  for (size_t channel = 0; channel < kNumFirstOrderAmbisonicChannels; ++channel) {
+    output_buffer_[channel] += crossfade_buffer_[channel];
+  }
+}
+
+const AudioBuffer* PerSourceReflectionsNode::AudioProcess(const NodeInput& input) {
+  const ReflectionProperties& properties = system_settings_.GetReflectionProperties();
+  room_position_ = WorldPosition(properties.room_position);
+  room_rotation_ = WorldRotation(properties.room_rotation);
+  room_dimensions_ = WorldPosition(properties.room_dimensions);
+  std::copy(std::begin(properties.coefficients), std::end(properties.coefficients),
+            std::begin(coefficients_));
+  cutoff_frequency_ = properties.cutoff_frequency;
+
+  const WorldPosition& listener_world = system_settings_.GetHeadPosition();
+  WorldPosition listener_local;
+  GetRelativeDirection(room_position_, room_rotation_.conjugate(), listener_world,
+                       &listener_local);
+
+  for (auto& entry : states_) {
+    entry.second->seen_this_buffer = false;
+  }
+
+  output_buffer_.Clear();
+  bool rendered_anything = false;
+
+  if (!mute_enabled_) {
+    for (const AudioBuffer* buffer : input.GetInputBuffers()) {
+      if (buffer == nullptr || buffer->num_channels() != kNumMonoChannels) {
+        continue;
+      }
+      const SourceId source_id = buffer->source_id();
+      const SourceParameters* parameters =
+          system_settings_.GetSourceParameters(source_id);
+      if (parameters == nullptr) {
+        continue;
+      }
+
+      SourceState* state = GetOrCreateState(source_id);
+      state->attenuation = parameters->attenuations[AttenuationType::kReflections];
+      state->position = listener_centric_sources_.count(source_id) > 0
+                            ? listener_world
+                            : parameters->object_transform.position;
+      UpdateTargets(listener_local, state->position, state->attenuation, state);
+      ProcessSource((*buffer)[0], state);
+      state->seen_this_buffer = true;
+      state->frames_since_input = 0;
+      rendered_anything = true;
+    }
+  }
+
+  // Tails: sources that went quiet (or were destroyed) keep rendering silence
+  // through their delay lines until their longest reflection has played out.
+  // Geometry keeps following the listener meanwhile, from the last known
+  // source position and attenuation.
+  for (auto it = states_.begin(); it != states_.end();) {
+    SourceState* state = it->second.get();
+    if (state->seen_this_buffer) {
+      ++it;
+      continue;
+    }
+    if (state->frames_since_input >= state->tail_frames) {
+      it = states_.erase(it);  // Fully rung out; recreated if it plays again.
+      continue;
+    }
+    UpdateTargets(listener_local, state->position, state->attenuation, state);
+    ProcessSource(silence_mono_buffer_[0], state);
+    state->frames_since_input += frames_per_buffer_;
+    rendered_anything = true;
+    ++it;
+  }
+
+  if (!rendered_anything) {
+    return nullptr;
+  }
+
+  // Into the listener's head frame, exactly as ReflectionsNode does.
+  const WorldRotation inverse_head_rotation =
+      system_settings_.GetHeadRotation().conjugate();
+  foa_rotator_.Process(inverse_head_rotation, output_buffer_, &output_buffer_);
+  return &output_buffer_;
+}
+
+}  // namespace vraudio
